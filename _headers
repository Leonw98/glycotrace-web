# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
# Conservative, safe defaults. No CSP yet (the site loads Google Fonts,
# gtag, and lucide from CDNs; a strict CSP would need those allow-listed
# first, so it is deliberately omitted to avoid breaking the pages).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Long cache for fingerprint-free static assets. Images rarely change;
# if one is replaced, its filename or ?v= query should change with it.
/Assets/*
  Cache-Control: public, max-age=31536000, immutable

/logo.png
  Cache-Control: public, max-age=604800

# CSS/JS are referenced with ?v= query strings in the HTML, so a day is safe.
/*.css
  Cache-Control: public, max-age=86400
/*.js
  Cache-Control: public, max-age=86400
